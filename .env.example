DISCORD_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=the_channel_that_receives_reports
X_BEARER_TOKEN=your_x_api_bearer_token

# Search query and polling interval can be customized.
X_QUERY=@CallofDutyCM has:videos -is:retweet
POLL_SECONDS=60

# Use /data when a Railway Volume is mounted there.
DATA_DIR=/data
